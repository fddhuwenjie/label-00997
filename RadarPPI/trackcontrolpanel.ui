  <property name="styleSheet">
   <string>
    QWidget#TrackControlPanel {
     background-color: #0F1410;
     border-top: 1px solid #1A251A;
    }
    QLabel {
     color: #00AA2A;
     font-size: 12px;
    }
    QLabel#timeLabel, QLabel#durationLabel {
     font-family: Consolas, Monaco, monospace;
     min-width: 60px;
    }
    QLabel#trackInfoLabel {
     color: #007A1E;
     font-size: 11px;
    }
    QPushButton {
     background-color: #1A251A;
     border: 1px solid #007A1E;
     border-radius: 4px;
     color: #00AA2A;
     padding: 6px 16px;
     min-width: 60px;
     font-size: 12px;
    }
    QPushButton:hover {
     background-color: #243024;
     border-color: #00AA2A;
     color: #00FF41;
    }
    QPushButton:pressed {
     background-color: #00AA2A;
     color: #0A0F0A;
    }
    QPushButton:disabled {
     background-color: #0F1410;
     border-color: #1A251A;
     color: #4A5A4A;
    }
    QPushButton#playButton {
     border-color: #00FF41;
     color: #00FF41;
    }
    QPushButton#pauseButton {
     border-color: #FFAA00;
     color: #FFAA00;
    }
    QPushButton#stopButton {
     border-color: #FF3333;
     color: #FF3333;
    }
    QPushButton#loadButton {
     border-color: #00AAFF;
     color: #00AAFF;
    }
    QSlider#progressSlider {
     min-height: 20px;
    }
    QSlider#progressSlider::groove:horizontal {
     border: 1px solid #1A251A;
     height: 6px;
     background: #0A0F0A;
     border-radius: 3px;
    }
    QSlider#progressSlider::sub-page:horizontal {
     background: #00AA2A;
     border-radius: 3px;
    }
    QSlider#progressSlider::add-page:horizontal {
     background: #1A251A;
     border-radius: 3px;
    }
    QSlider#progressSlider::handle:horizontal {
     background: #00FF41;
     border: 2px solid #00AA2A;
     width: 14px;
     margin: -5px 0;
     border-radius: 7px;
    }
    QSlider#progressSlider::handle:horizontal:hover {
     background: #00FF41;
     border-color: #00FF41;
    }
    QComboBox#speedComboBox {
     background-color: #1A251A;
     border: 1px solid #007A1E;
     border-radius: 4px;
     color: #00AA2A;
     padding: 4px 10px;
     min-width: 60px;
     font-size: 12px;
    }
    QComboBox#speedComboBox:hover, QComboBox#speedComboBox:focus {
     border-color: #00AA2A;
     color: #00FF41;
    }
    QComboBox#speedComboBox::drop-down {
     border: none;
     width: 20px;
    }
    QComboBox#speedComboBox QAbstractItemView {
     background-color: #1A251A;
     border: 1px solid #007A1E;
     color: #00AA2A;
     selection-background-color: #007A1E;
     selection-color: #00FF41;
    }
   </string>
